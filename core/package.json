{
  "name": "@uadenet/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "CORE simulado de UADEnet: login, gateway, billetera y eventos",
  "scripts": {
