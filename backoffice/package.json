{
  "name": "@uadenet/backoffice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Backoffice simulado: publica mensajes en RabbitMQ",
  "scripts": {
    "publish:rate": "tsx src/publicar.ts rate",
    "publish:location": "tsx src/publicar.ts location",
    "publish:invalid": "tsx src/publicar.ts invalid",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
